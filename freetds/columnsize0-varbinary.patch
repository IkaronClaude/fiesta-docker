+	/* FreeTDS fork (Ikaron 2026-07-07): a VARIABLE-length param bound with ColumnSize 0 (SQLBindParameter
+	 * arg 6 == 0) means "the length is the data length" — that's what MS ODBC Driver 17/18 do — NOT a
+	 * 0-byte value. Stock FreeTDS left column_size at 0, so the param buffer was alloc'd 0 bytes and the
+	 * binary/char value got clamped to 0 on the wire (see the SYBVARBINARY clamp below). That truncated the
+	 * Fiesta quest-progress varbinary to empty 0x (tQuest.sData), losing in-progress kill counts on relog.
+	 * Now that `len` (the real source length) is known, size the column from it before the buffer alloc so
+	 * the full value is sent. Scoped to non-null, non-fixed, variable-length (column_varint_size!=0) params. */
+	if (curcol->column_size == 0 && !need_data && curcol->column_varint_size != 0
+	    && !is_fixed_type(dest_type) && len > 0) {
+		curcol->column_size = len;
+		curcol->on_server.column_size = is_unicode_type(dest_type) ? len * 2 : len;
+	}
+
 	if (is_char_type(dest_type) && !need_data
 	    && (sql_src_type == SQL_C_CHAR || sql_src_type == SQL_C_WCHAR || sql_src_type == SQL_C_BINARY)) {
